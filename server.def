Bootstrap: docker
From: ubuntu:22.04

%labels
    Author long_read_visualization
    Description Multi-panel IGV.js visualization server for long-read SV review

%help
    Multi-panel IGV.js visualization server for reviewing structural variants
    across a reference genome and both haplotype assemblies.

    Quick start with the toy dataset (bind your working directory):

        apptainer exec --bind "${PWD}:/work" server.sif \
            bash /opt/long_read_visualization/scripts/launch_server.sh \
            --toy --port 8080

    Start with a configuration file:

        apptainer exec --bind "${PWD}:/work" server.sif \
            python3 /opt/long_read_visualization/server/app.py \
            --config /work/samples.tsv --port 8080

    Generate a config from pipeline outputs:

        apptainer exec --bind "${PWD}:/work" server.sif \
            python3 /opt/long_read_visualization/scripts/generate_server_config.py \
            --output-dir /work/output/NA21110 \
            --reference /work/references/chm13v2.0.fa.gz \
            --hap1 /work/NA21110/NA21110_hap1.fa.gz \
            --hap2 /work/NA21110/NA21110_hap2.fa.gz \
            --regions /work/regions/NA21110_svs.vcf.gz \
            -o /work/samples.tsv

    Multi-sample auto-scan:

        apptainer exec --bind "${PWD}:/work" server.sif \
            python3 /opt/long_read_visualization/scripts/generate_server_config.py \
            --scan-dir /work/output \
            --reference /work/references/chm13v2.0.fa.gz \
            -o /work/samples.tsv

    All paths in the TSV must be valid inside the container.  Bind-mount your
    project root to /work and use /work/... paths everywhere.

%post
    export DEBIAN_FRONTEND=noninteractive

    apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        python3 \
        python3-pip \
    && rm -rf /var/lib/apt/lists/*

    mkdir -p /opt/long_read_visualization

%files
    server/ /opt/long_read_visualization/server/
    src/ /opt/long_read_visualization/src/
    scripts/ /opt/long_read_visualization/scripts/
    resources/ /opt/long_read_visualization/resources/

%environment
    export PATH="/opt/long_read_visualization/scripts:${PATH}"

%runscript
    exec python3 /opt/long_read_visualization/server/app.py "$@"
